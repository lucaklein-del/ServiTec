<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F4F5F7">

    <!-- COLUMNA IZQUIERDA (AZUL OSCURO) -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:background="#1B3358"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO DE LA APP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ServiTec"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panell de Direcció"
            android:textColor="#9EAEC7"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- BOTÓN SELECCIONADO: DIRECCIÓ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNavGerencia"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="DIRECCIÓ"
            android:textAlignment="textStart"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- BOTÓN PARA IR A LA VISTA DE CAMARERO / MESAS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVistaCambrer"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VISTA TAULES"
            android:textAlignment="textStart"
            android:textColor="#9EAEC7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ESPACIADOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BOTÓN TANCAR SESSIÓ -->
        <TextView
            android:id="@+id/btnTancarSessio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•  Tancar Sessió"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ÁREA CENTRAL (FILAS DE 3 TARJETAS) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestió i Administració del Restaurant"
            android:textColor="#1B3358"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- GRID DE 8 TARJETAS EN 3 COLUMNAS -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <!-- FILA 1: ACCIONES DE AÑADIR -->

            <!-- 1. AFEGIR PRODUCTE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAfegirProducte"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➕ 🍔" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Afegir Producte" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. AFEGIR MENJADOR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAfegirMenjador"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➕ 🪑" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Afegir Menjador" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. AFEGIR USUARI -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAfegirUsuari"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:id="@+id/AfegirUsuari"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/AfegirUsuari"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤➕"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Afegir Usuari"
                        android:textColor="#1B3358"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FILA 2: MÓDULOS DE GESTIÓN -->

            <!-- 4. GESTIONAR PRODUCTES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarProductes"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✏️ 📜" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestionar Productes" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. GESTIONAR MENJADORS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarMenjadors"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️ 📐" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestionar Menjadors" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 6. GESTIONAR PERSONAL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarUsuaris"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👥 🔑" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gestionar Personal" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FILA 3: TRABAJO FUTURO -->

            <!-- 7. INFORMES I VENDES (EN PROCÉS) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInformes"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊 💶" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Informes i Vendes" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(En procés)" android:textColor="#D97706" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 8. CONTROL DE STOCKS (EN PROCÉS) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStocks"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦 📋" android:textSize="30sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Control de Stocks" android:textColor="#1B3358" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="(En procés)" android:textColor="#D97706" android:textSize="12sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#F8F9FA">

    <!-- COLUMNA IZQUIERDA UNIFICADA (240dp) -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:background="@color/blau_primari"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ServiTec"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Panell de control"
            android:textColor="#9EAEC7"
            android:textSize="12sp" />

        <!-- BOTÓN SALA (ACTIVO) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSala"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="SALA"
            android:textAlignment="textStart"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#3B82F6"
            app:cornerRadius="12dp" />

        <!-- BOTÓN TERRASSA (INACTIVO) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerrassa"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:text="TERRASSA"
            android:textAlignment="textStart"
            android:textColor="#9EAEC7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- BOTÓN DIRECCIÓ (INACTIVO) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDireccio"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="DIRECCIÓ"
            android:textAlignment="textStart"
            android:textColor="#9EAEC7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ESPACIADOR FLEXIBLE -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- TANCAR SESSIÓ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Tancar Sessió"
            android:textAlignment="textStart"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ÁREA PRINCIPAL DE CONTENIDO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Leyenda de colores de mesas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@color/taula_lliure" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="Lliure"
                android:textSize="12sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@color/taula_ocupada2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ocupada"
                android:layout_marginEnd="20dp"
                android:textSize="12sp"/>

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp"
                android:background="@color/taula_pendent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Layout de distribución de las mesas -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSalon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:backgroundTint="#05000000">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/taula2"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginStart="432dp"
                android:layout_marginTop="148dp"
                android:background="@drawable/bg_taula_8pax"
                android:text="Taula 10\n(8 Pax)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/taula4"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="52dp"
                android:background="@drawable/bg_taula_4pax"
                android:text="Taula 11\n(4 Pax)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.916"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/taula5"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_taula_4pax"
                android:text="Taula 12\n(4 Pax)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/taula6"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginStart="432dp"
                android:layout_marginTop="404dp"
                android:background="@drawable/bg_taula_6pax"
                android:text="Taula 13\n(6 Pax)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/taula7"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginStart="72dp"
                android:layout_marginTop="500dp"
                android:background="@drawable/bg_taula_2pax"
                android:text="Taula 14\n(2 Pax)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/taula8"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginStart="760dp"
                android:layout_marginTop="512dp"
                android:background="@drawable/bg_taula_2pax"
                android:text="Taula 15\n(2 Pax)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>